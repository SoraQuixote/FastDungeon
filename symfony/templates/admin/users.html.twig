{% extends 'base.html.twig' %}

{% block title %}Gestion des Utilisateurs{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="text-center mb-4">🛡️ Gestion des Aventuriers</h1>

    <div class="table-responsive" style="background: rgba(255, 255, 255, 0.8); padding: 20px; border-radius: 10px; border: 2px solid #5d4037;">
        <table class="table table-hover">
            <thead style="background-color: #5d4037; color: white;">
                <tr>
                    <th>ID</th>
                    <th>Pseudo</th>
                    <th>Rôles</th>
                    <th>Nombre de Persos</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td><strong>{{ user.pseudo }}</strong></td>
                    <td>
                        {% for role in user.getRoles %}
                            <span class="badge {{ role == 'ROLE_ADMIN' ? 'bg-danger' : 'bg-primary' }}">
                                {{ role }}
                            </span>
                        {% endfor %}
                    </td>
                    <td>{{ user.personnages|length }}</td>
                    <td>
                       <td>
                            <div style="display: flex; gap: 5px;">
                                {# Bouton Changer Rôle #}
                                <form method="post" action="{{ path('app_admin_user_toggle_role', {'id': user.id}) }}" onsubmit="return confirm('Changer les droits de cet utilisateur ?');">
                                    <button class="btn btn-sm {{ 'ROLE_ADMIN' in user.roles ? 'btn-warning' : 'btn-success' }}" title="Promouvoir / Rétrograder">Droits </button>
                                </form>

                                {# Bouton Supprimer #}
                                {% if user != app.user %}
                                    <form method="post" action="{{ path('app_admin_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir bannir cet aventurier ? Tous ses personnages seront perdus !');">
                                        <button class="btn btn-sm btn-danger" title="Bannir"> Supprimer</button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                        <button class="btn btn-sm btn-outline-dark" title="Voir le profil">👁️</button>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="text-center">Aucun aventurier inscrit dans la taverne.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_admin_dashboard') }}" class="btn btn-secondary">Retour au Dashboard</a>
    </div>
</div>
{% endblock %}