{% extends 'base.html.twig' %}

{% block title %}Inscription - FastDungeon{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/Login-register.css') }}">
{% endblock %}

{% block body %}
<div class="auth-container">
    <div class="auth-card">
        <h1 class="medieval-title">Nouveau Personnage</h1>

        {{ form_start(registrationForm, {'attr': {'class': 'medieval-form'}}) }}
            <div class="form-group">
                {{ form_label(registrationForm.pseudo, "Pseudo de l'aventurier") }}
                {{ form_widget(registrationForm.pseudo, {'attr': {'class': 'input-medieval'}}) }}
            </div>

            <div class="form-group">
                {{ form_label(registrationForm.plainPassword, "Mot de passe") }}
                {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'input-medieval'}}) }}
            </div>

            <div class="checkbox-container">
                {{ form_widget(registrationForm.agreeTerms) }}
                {{ form_label(registrationForm.agreeTerms, "Agree terms") }}
            </div>

            <div class="auth-actions">
                <button type="submit" class="btn-medieval-submit">Créer le compte</button>
                <p class="auth-link">Déjà membre ? <a href="{{ path('app_login') }}">Retourner au comptoir</a></p>
            </div>
        {{ form_end(registrationForm) }}
    </div>
</div>
{% endblock %}