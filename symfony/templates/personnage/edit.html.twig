{% extends 'base.html.twig' %}

{% block title %}Modifier {{ personnage.prenom }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/fiche-personnage.css') }}">
{% endblock %}

{% block body %}

<form method="post" enctype="multipart/form-data">
    <input type="hidden" name="personnage[_token]" value="{{ csrf_token('personnage') }}">

    {# ===== EN-TÊTE ===== #}
    <div class="fiche-header">
        <div class="header-left">
            <button type="submit" class="btn-medieval">Sauvegarder</button>
            <button type="button" class="btn-medieval tab-btn active" onclick="switchTab('general')">📜 Général</button>
            <button type="button" class="btn-medieval tab-btn" onclick="switchTab('equipement')">⚔ Équipement</button>
        </div>
        
        <h2 class="fiche-titre">✦ {{ personnage.prenom|default('Nouveau Héros') }} ✦</h2>
        
        <div class="fiche-header-actions">
           {% if personnage.id %}
                <button type="submit" form="delete-form" class="btn-medieval btn-supprimer">
                    Supprimer le personnage
                </button>
            {% endif %}
            <a href="{{ path('app_personnage_index') }}" class="btn-medieval btn-quitter">✖ Annuler</a>
        </div>
    </div>

    <div class="fiche-container">
        
        {# --- ONGLET GÉNÉRAL --- #}
        <div id="tab-general" class="tab-content active">
            {# C'est ICI que fiche-main doit englober les 4 colonnes #}
            <div class="fiche-main">

                {# --- COLONNE 1 : Nom + Portrait --- #}
                <div class="fiche-col-gauche">
                    <label for="personnage_nom">Nom du personnage</label>
                    <input type="text" id="personnage_nom" name="personnage[nom]" value="{{ personnage.nom|default('') }}" required>

                    <label for="personnage_prenom">Prénom</label>
                    <input type="text" id="personnage_prenom" name="personnage[prenom]" value="{{ personnage.prenom|default('') }}">

                    <label for="personnage_niveau">Niveau</label>
                    <input type="number" id="personnage_niveau" name="personnage[niveau]" value="{{ personnage.niveau|default(1) }}" min="1">

                    <div class="portrait-zone" onclick="document.getElementById('uploadPortrait').click()" title="Cliquez pour ajouter un portrait">
                        {% if personnage.portrait %}
                            <img id="portraitPreview" src="{{ asset('uploads/portraits/' ~ personnage.portrait) }}" alt="Portrait">
                        {% else %}
                            <img id="portraitPreview" src="" alt="" style="display:none;">
                            <div id="portraitPlaceholder">
                                <span class="portrait-icone"></span>
                                <span class="portrait-texte">Cliquez pour ajouter un portrait</span>
                            </div>
                        {% endif %}
                        <input type="file" id="uploadPortrait" name="personnage[portrait]" accept="image/*" hidden>
                    </div>
                </div>

                {# --- COLONNE 2 : PV + Stats --- #}
                <div class="fiche-col-centre">
                    <div class="pv-bloc">
                        <span class="pv-label">Vie</span>
                        <button type="button" class="btn-stat" onclick="changeVie(-1)">−</button>
                        <span id="vieActuelle" class="pv-valeur">{{ personnage.vieActuelle|default(10) }}</span>
                        <button type="button" class="btn-stat" onclick="changeVie(1)">+</button>
                        <div class="vie-barre-container">
                            <div class="vie-barre" id="lifeFill"></div>
                        </div>
                        <div class="pv-max-ligne">
                            Max :
                            <input type="number" id="vieMax" name="personnage[pointDeVie]" value="{{ personnage.pointDeVie|default(10) }}" min="1" onchange="updateVieBar()">
                        </div>
                        <input type="hidden" id="vieActuelleInput" name="personnage[vieActuelle]" value="{{ personnage.vieActuelle|default(10) }}">
                    </div>

                    <hr class="fiche-separateur-stats">

                    {# Stats dynamiques #}
                    <div class="stats-dynamiques">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                            <span style="font-weight:bold; color:#5a3a1b;">Stats & Résistances</span>
                            <button type="button" class="btn-medieval" onclick="openStatModal()" style="padding:4px 10px; font-size:0.8rem;">+ Ajouter</button>
                        </div>
                        <div id="liste-stats"></div>
                    </div>
                </div>

                {# --- COLONNE 3 : Capacités --- #}
                <div class="fiche-col-attaques">
                    <h3>Capacités</h3>
                    <button type="button" class="btn-medieval" onclick="openAttaqueModal()">⚔ Créer une Capacité</button>
                    <div class="cat-attaque-section">
                        <h4>⚔ Physiques</h4>
                        <div id="liste-physique" class="attaques-container">
                            <p class="empty-msg">Aucune attaque physique.</p>
                        </div>
                    </div>
                    <div class="cat-attaque-section">
                        <h4>✨ Magiques</h4>
                        <div id="liste-magique" class="attaques-container">
                            <p class="empty-msg">Aucun sort magique.</p>
                        </div>
                    </div>
                </div>

                {# --- COLONNE 4 : Histoire --- #}
                <div class="fiche-col-droite">
                    <h3>Carnet de voyage</h3>
                    <textarea name="personnage[carnetDeVoyage]" class="fiche-textarea">{{ personnage.carnetDeVoyage|default('') }}</textarea>
                    <h3 style="margin-top: 15px;">Histoire</h3>
                    <textarea name="personnage[histoire]" class="fiche-textarea">{{ personnage.histoire|default('') }}</textarea>
                </div>
            </div>
        </div>

        {# --- ONGLET ÉQUIPEMENT --- #}
        <div id="tab-equipement" class="tab-content" style="display:none;">
            <div class="equipement-grid">
                <div class="equipement-card">
                    <h3>🗡 Arme Équipée</h3>
                    <div class="form-group">
                        <label>Nom de l'arme</label>
                        <input type="text" name="personnage[arme][nom]" value="{{ personnage.arme.nom|default('') }}">
                        <label>Bonus Attaque</label>
                        <input type="number" name="personnage[arme][ptsDegat]" value="{{ personnage.arme.ptsDegat|default(0) }}">
                        <label>Description</label>
                        <textarea name="personnage[arme][description]">{{ personnage.arme.description|default('') }}</textarea>
                    </div>
                </div>

                <div class="equipement-card">
                    <h3>🛡 Armure Équipée</h3>
                    <div class="form-group">
                        <label>Nom de l'armure</label>
                        <input type="text" name="personnage[armure][nom]" value="{{ personnage.armure.nom|default('') }}">
                        <label>Bonus Défense</label>
                        <input type="number" name="personnage[armure][bonus]" value="{{ personnage.armure.bonus|default(0) }}">
                        <label>Description</label>
                        <textarea name="personnage[armure][description]">{{ personnage.armure.description|default('') }}</textarea>
                    </div>
                </div>

                <div class="equipement-card full-width">
                    <h3>🎒 Objets Spéciaux</h3>
                    <div id="objets-list-container" class="grid-objets"></div>
                    <button type="button" class="btn-medieval" onclick="openObjetModal()">+ Ajouter un objet</button>
                </div>
            </div>
        </div>

        {# --- INVENTAIRE --- #}
        <div class="inventaire-section">
            <h3>Inventaire Global</h3>
            <textarea name="personnage[inventaire]" class="fiche-textarea fiche-textarea-inventaire">{{ personnage.inventaire|default('') }}</textarea>
        </div>
    </div>

    {# ===== MODALE DE CRÉATION / MODIFICATION D'ATTAQUE ===== #}
    <div id="modalAttaque" class="modal-medieval" style="display:none;">
        <div class="modal-content">
            <h3 id="modalTitle"> Nouvelle Capacité</h3>
            <input type="hidden" id="edit_index">

            <div class="form-row">
                <div class="form-group">
                    <label>Type d'attaque</label>
                    <select id="atk_type" onchange="toggleTypeFields()">
                        <option value="physique">Physique</option>
                        <option value="magique">Magique</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Nom</label>
                    <input type="text" id="atk_nom">
                </div>
            </div>

            <!-- CHAMPS GLOBAUX (Attaque) -->
            <div class="form-row">
                <div>
                    <label>Jet de dés</label>
                    <input type="text" id="atk_degat" placeholder="Ex: 2d6+3">
                </div>
                <div>
                    <label>Coût</label>
                    <input type="text" id="atk_cout_global" placeholder="Ex: 2 mana">
                </div>
            </div>

            <div class="form-row">
                <div>
                    <label>Portée</label>
                    <input type="text" id="atk_portee">
                </div>
                <div>
                    <label>Effet</label>
                    <input type="text" id="atk_effet">
                </div>
            </div>

            <!-- SPÉCIFIQUE PHYSIQUE -->
            <div id="field_contre">
                <label>Jet de contre</label>
                <input type="text" id="atk_contre" placeholder="Ex: 1d4">
            </div>

            <div class="form-group">
                <label>Description détaillée</label>
                <textarea id="atk_desc" rows="2"></textarea>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-medieval" onclick="sauvegarderAttaque()">Enregistrer</button> 
                <button type="button" class="btn-medieval btn-quitter" onclick="closeAttaqueModal()">Annuler</button>
            </div>
        </div>
    </div>
    {# ===== MODALE OBJET ===== #}
    <div id="modalObjet" class="modal-medieval" style="display:none;">
        <div class="modal-content">
            <h3 id="objModalTitle">Nouvel Objet</h3>
            <input type="hidden" id="obj_edit_index">

            <div class="form-group">
                <label>Nom de l'objet</label>
                <input type="text" id="obj_nom">
            </div>

            <div class="form-row">
                <div>
                    <label>Dégâts (ptsDegat)</label>
                    <input type="number" id="obj_degat" value="0">
                </div>
                <div>
                    <label>Vie (ptsDeVie)</label>
                    <input type="number" id="obj_vie" value="0">
                </div>
            </div>

            <div class="form-group">
                <label>Effet</label>
                <input type="text" id="obj_effet" placeholder="Ex: +2 en Force">
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea id="obj_desc" rows="3"></textarea>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-medieval" onclick="sauvegarderObjet()">Enregistrer</button>
                <button type="button" class="btn-medieval btn-quitter" onclick="closeObjetModal()">Annuler</button>
            </div>
        </div>
    </div>
    {# ===== MODALE STAT ===== #}
    <div id="modalStat" class="modal-medieval" style="display:none;">
        <div class="modal-content">
            <h3 id="statModalTitle">Nouvelle Stat</h3>
            <input type="hidden" id="stat_edit_index">

            <div class="form-group">
                <label>Nom de la stat</label>
                <input type="text" id="stat_nom" placeholder="Ex: Force, Agilité, Résistance Feu...">
            </div>

            <div class="form-group">
                <label>Valeur</label>
                <input type="number" id="stat_valeur" value="0">
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-medieval" onclick="sauvegarderStat()">Enregistrer</button>
                <button type="button" class="btn-medieval btn-quitter" onclick="closeStatModal()">Annuler</button>
            </div>
        </div>
    </div>
</form>
{# FORMULAIRE DE SUPPRESSION#}
{% if personnage.id %}
    <form id="delete-form" method="post" action="{{ path('app_personnage_delete', {'id': personnage.id}) }}" 
          onsubmit="return confirm('Voulez-vous vraiment supprimer ce personnage ?');" 
          style="display: none;">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ personnage.id) }}">
    </form>
{% endif %}
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/fiche-personnage.js') }}"></script>
    <script>
        attaquesData = [
            {% for atk in personnage.attaques %}
            {
                nom: "{{ atk.nom|e('js') }}",
                type: "{{ atk.discriminatorType }}",
                degat: {{ atk.ptsDegat|default(0) }},
                cout: {{ atk.cout|default(0) }},
                portee: "{{ atk.portee|e('js') }}",
                effet: "{{ atk.effet|e('js') }}",
                desc: "{{ atk.description|e('js') }}",
                contre: {{ (atk.discriminatorType == 'physique') ? atk.degatDeContre|default(0) : 0 }},
            },
            {% endfor %}
        ];

        objetsData = [
            {% for obj in personnage.objets %}
            {
                nom: "{{ obj.nom|e('js') }}",
                degat: {{ obj.ptsDegat|default(0) }},
                ptsDeVie: {{ obj.ptsDeVie|default(0) }},
                effet: "{{ obj.effet|e('js') }}",
                desc: "{{ obj.description|e('js') }}"
            },
            {% endfor %}
        ];

        statsData = [
            {% for stat in personnage.stats %}
            {
                nom: "{{ stat.nom|e('js') }}",
                valeur: {{ stat.valeur|default(0) }}
            },
            {% endfor %}
        ];

        document.addEventListener("DOMContentLoaded", function() {
            renderAttaques();
            renderObjets();
            renderStats();
        });
    </script>
{% endblock %}