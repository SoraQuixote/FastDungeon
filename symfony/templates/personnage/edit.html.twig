{# templates/personnage/edit.html.twig #}
{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/personnage-new.css') }}">
    <link rel="stylesheet" href="style.css">

    <link rel="stylesheet" href="style.css?v=1">
{% endblock %}

{% block body %}
    {# Formulaire principal de modification #}
    <form method="post" enctype="multipart/form-data" action="{{ path('app_personnage_edit', {'id': personnage.id}) }}">
        <input type="hidden" name="personnage[_token]" value="{{ csrf_token('personnage') }}">

        {# ===== EN-TÊTE ===== #}
        <div class="fiche-header">
            <button type="submit" class="btn-medieval"> Sauvegarder</button>
            <h2 class="fiche-titre">✦ Personnage : {{ personnage.prenom }} ✦</h2>
            <div class="fiche-header-actions">
                {# BOUTON SUPPRIMER #}
                <button type="button" class="btn-medieval btn-danger" 
                        onclick="if(confirm('Voulez-vous vraiment supprimer ce héros ?')) { document.getElementById('delete-form').submit(); }"
                        style="background-color: #5a0000; color: white;">
                    ✖ Supprimer le personnage
                </button>
                
                <a href="{{ path('app_personnage_index') }}" class="btn-medieval btn-quitter">✖ Annuler</a>
            </div>
        </div>

        {# ===== ZONE PRINCIPALE ===== #}
        <div class="fiche-main">

            {# --- COLONNE 1 : Nom + Portrait --- #}
            <div class="fiche-col-gauche">
                <label for="personnage_nom">Nom du personnage</label>
                <input type="text" id="personnage_nom" name="personnage[nom]" value="{{ personnage.nom }}" required>

                <label for="personnage_prenom">Prénom</label>
                <input type="text" id="personnage_prenom" name="personnage[prenom]" value="{{ personnage.prenom }}">

                <label for="personnage_niveau">Niveau</label>
                <input type="number" id="personnage_niveau" name="personnage[niveau]" value="{{ personnage.niveau|default(1) }}" min="1">

                <div class="portrait-zone" onclick="document.getElementById('uploadPortrait').click()" title="Cliquez pour changer le portrait">
                    <img id="portraitPreview" 
                        src="{{ personnage.portrait ? asset('uploads/portraits/' ~ personnage.portrait) : '' }}" 
                        alt="Portrait" 
                        style="{{ personnage.portrait ? '' : 'display:none;' }}">
                    
                    <div id="portraitPlaceholder" style="{{ personnage.portrait ? 'display:none;' : '' }}">
                        <span class="portrait-icone"></span>
                        <span class="portrait-texte">Cliquez pour changer le portrait</span>
                    </div>
                    <input type="file" id="uploadPortrait" name="personnage[portrait]" accept="image/*" hidden>
                </div>
            </div>

            {# --- COLONNE 2 : PV + Stats --- #}
            <div class="fiche-col-centre">
                <div class="pv-bloc">
                    <span class="pv-label">Vie</span>
                    <button type="button" class="btn-stat" onclick="changeVie(-1)">−</button>
                    <span id="vieActuelle" class="pv-valeur">{{ personnage.vieActuelle|default(10) }}</span>
                    <button type="button" class="btn-stat" onclick="changeVie(1)">+</button>
                    <div class="vie-barre-container">
                        <div class="vie-barre" id="lifeFill"></div>
                    </div>
                    <div class="pv-max-ligne">
                        Max :
                        <input type="number" id="vieMax" name="personnage[pointDeVie]" value="{{ personnage.pointDeVie|default(10) }}" min="1" onchange="updateVieBar()">
                    </div>
                    {# Ce champ est celui qui envoie la valeur au serveur #}
                    <input type="hidden" id="vieActuelleInput" name="personnage[vieActuelle]" value="{{ personnage.vieActuelle|default(10) }}">
                </div>

                <hr class="fiche-separateur-stats">

                {# Caractéristiques #}
                {% set statsFields = {
                    'stateForce': 'Force',
                    'stateConstitution': 'Constitution',
                    'stateRapidite': 'Rapidité',
                    'stateIntelligence': 'Intelligence',
                    'resistancePhysique': 'Rés. Physique',
                    'resistanceMagique': 'Rés. Magique',
                    'resistanceMentale': 'Rés. Mentale'
                } %}

                {% for key, label in statsFields %}
                    <div class="stat-ligne">
                        <span class="stat-nom">{{ label }}</span>
                        <button type="button" class="btn-stat" onclick="changeStat('{{ key }}', -1)">−</button>
                        <span class="stat-valeur" id="{{ key }}">{{ attribute(personnage, key)|default(0) }}</span>
                        <button type="button" class="btn-stat" onclick="changeStat('{{ key }}', 1)">+</button>
                        <input type="hidden" name="personnage[{{ key }}]" id="{{ key }}_input" value="{{ attribute(personnage, key)|default(0) }}">
                    </div>
                    {% if loop.index == 4 %}<hr class="fiche-separateur-stats">{% endif %}
                {% endfor %}
            </div>

            {# --- COLONNE 3 : Capacités --- #}
            <div class="fiche-col-attaques">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <h3>Capacités</h3>
                    <button type="button" class="btn-medieval" onclick="openAttaqueModal()">⚔ Créer une Capacité</button>
                </div>
                
                <div class="cat-attaque-section">
                    <h4>⚔ Physiques</h4>
                    <div id="liste-physique" class="attaques-container">
                        <p class="empty-msg">Chargement...</p>
                    </div>
                </div>

                <div class="cat-attaque-section">
                    <h4>✨ Magiques</h4>
                    <div id="liste-magique" class="attaques-container">
                        <p class="empty-msg">Chargement...</p>
                    </div>
                </div>
            </div>

            {# --- COLONNE 4 : Carnet + Histoire --- #}
            <div class="fiche-col-droite">
                <h3>Carnet de voyage</h3>
                <textarea name="personnage[carnetDeVoyage]" class="fiche-textarea">{{ personnage.carnetDeVoyage }}</textarea>

                <h3 style="margin-top: 15px;">Histoire</h3>
                <textarea name="personnage[histoire]" class="fiche-textarea">{{ personnage.histoire }}</textarea>
            </div>
        </div>

        {# ===== INVENTAIRE ===== #}
        <div class="inventaire-section">
            <h3>Inventaire</h3>
            <textarea name="personnage[inventaire]" class="fiche-textarea fiche-textarea-inventaire">{{ personnage.inventaire }}</textarea>
        </div>
    </form>

    {# ===== MODALE (Placée à l'extérieur du formulaire) ===== #}
    <div id="modalAttaque" class="modal-medieval" style="display:none;">
        <div class="modal-content">
            <h3 id="modalTitle">Nouvelle Capacité</h3>
            <input type="hidden" id="edit_index">

            <div class="form-row">
                <div class="form-group">
                    <label>Type d'attaque</label>
                    <select id="atk_type" onchange="toggleTypeFields()">
                        <option value="physique">Physique</option>
                        <option value="magique">Magique</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Nom</label>
                    <input type="text" id="atk_nom">
                </div>
            </div>

            <div class="form-row">
                <div>
                    <label>Dégâts</label>
                    <input type="number" id="atk_degat">
                </div>
                <div>
                    <label>Coût</label>
                    <input type="number" id="atk_cout_global">
                </div>
            </div>

            <div class="form-row">
                <div><label>Portée</label><input type="text" id="atk_portee"></div>
                <div><label>Effet</label><input type="text" id="atk_effet"></div>
            </div>

            <div id="field_contre">
                <label>Dégât de Contre</label>
                <input type="number" id="atk_contre">
            </div>

            <div id="field_magie" style="display:none;">
                <div class="form-row">
                    <div><label>ptsDeVie</label><input type="number" id="atk_magie_pv"></div>
                    <div>
                        <label>Type de Magie</label>
                        <select id="atk_magie_type">
                            <option value="Magie noire">Magie noire</option>
                            <option value="Magie blanche">Magie blanche</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>Description détaillée</label>
                <textarea id="atk_desc" rows="2"></textarea>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-medieval" onclick="sauvegarderAttaque()">Enregistrer</button>
                <button type="button" class="btn-medieval btn-quitter" onclick="closeAttaqueModal()">Annuler</button>
            </div>
        </div>
    </div>

    {# Formulaire de suppression caché #}
    <form id="delete-form" method="post" action="{{ path('app_personnage_delete', {'id': personnage.id}) }}" style="display:none;">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ personnage.id) }}">
    </form>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/fiche-personnage.js') }}"></script>
<script>
    // On initialise le tableau vide
    attaquesData = [];

    {% if personnage.attaques is defined and personnage.attaques is not null %}
        {% for atk in personnage.attaques %}
            attaquesData.push({
                nom: "{{ atk.nom|e('js') }}",
                type: "{{ atk.discriminatorType }}",
                degat: {{ atk.ptsDegat ?? 0 }},
                cout: {{ atk.cout ?? 0 }},
                portee: "{{ atk.portee|e('js') }}",
                effet: "{{ (atk.effet ?? '')|e('js') }}",
                desc: "{{ (atk.description ?? '')|e('js') }}",
                contre: {{ atk.discriminatorType == 'physique' ? (atk.degatDeContre ?? 0) : 0 }},
                ptsDeVie: {{ atk.discriminatorType == 'magique' ? (atk.ptsDeVie ?? 0) : 0 }},
                magieType: "{{ atk.discriminatorType == 'magique' ? atk.type|e('js') : '' }}"
            });
        {% endfor %}
    {% endif %}

    // On lance le rendu
    document.addEventListener("DOMContentLoaded", function() {
        if (typeof renderAttaques === "function") {
            renderAttaques();
        }
    });
</script>
{% endblock %}