{% extends 'base.html.twig' %}

{% block title %}Créer un Personnage{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/fiche-personnage.css') }}">
{% endblock %}

{% block body %}

<form method="post" enctype="multipart/form-data" class="fiche-personnage">

    {# ===== EN-TÊTE ===== #}
    <div class="fiche-header">
        <button type="submit" class="btn-medieval">📜 Sauvegarder</button>
        <h2 class="fiche-titre">✦ Création du Personnage ✦</h2>
        <div class="fiche-header-actions">
            {# Le bouton ouvre maintenant la modale de création #}
            <button type="button" class="btn-medieval" onclick="openAttaqueModal()">⚔ Créer une Capacité</button>
            <a href="{{ path('app_personnage_index') }}" class="btn-medieval btn-quitter">✖ Annuler</a>
        </div>
    </div>

    {# ===== ZONE PRINCIPALE 4 COLONNES ===== #}
    <div class="fiche-main">

        {# --- COLONNE 1 : Nom + Portrait --- #}
        <div class="fiche-col-gauche">
            <label for="personnage_nom">Nom du personnage</label>
            <input type="text" id="personnage_nom" name="personnage[nom]" required>

            <label for="personnage_prenom">Prénom</label>
            <input type="text" id="personnage_prenom" name="personnage[prenom]">

            <label for="personnage_niveau">Niveau</label>
            <input type="number" id="personnage_niveau" name="personnage[niveau]" value="1" min="1">

            <div class="portrait-zone" onclick="document.getElementById('uploadPortrait').click()" title="Cliquez pour ajouter un portrait">
                <img id="portraitPreview" src="" alt="" style="display:none;">
                <div id="portraitPlaceholder">
                    <span class="portrait-icone"></span>
                    <span class="portrait-texte">Cliquez pour ajouter un portrait</span>
                </div>
                <input type="file" id="uploadPortrait" name="personnage[portrait]" accept="image/*" hidden>
            </div>
        </div>

        {# --- COLONNE 2 : PV + Stats + Résistances --- #}
        <div class="fiche-col-centre">
            {# Points de vie #}
            <div class="pv-bloc">
                <span class="pv-label">Vie</span>
                <button type="button" class="btn-stat" onclick="changeVie(-1)">−</button>
                <span id="vieActuelle" class="pv-valeur">10</span>
                <button type="button" class="btn-stat" onclick="changeVie(1)">+</button>
                <div class="vie-barre-container">
                    <div class="vie-barre" id="lifeFill"></div>
                </div>
                <div class="pv-max-ligne">
                    Max :
                    <input type="number" id="vieMax" name="personnage[pointDeVie]" value="10" min="1" onchange="updateVieBar()">
                </div>
                <input type="hidden" id="vieActuelleInput" name="personnage[vieActuelle]" value="10">
            </div>

            <hr class="fiche-separateur-stats">

            {# Caractéristiques #}
            <div class="stat-ligne"><span class="stat-nom">Force</span><button type="button" class="btn-stat" onclick="changeStat('stateForce', -1)">−</button><span class="stat-valeur" id="stateForce">0</span><button type="button" class="btn-stat" onclick="changeStat('stateForce', 1)">+</button><input type="hidden" name="personnage[stateForce]" id="stateForce_input" value="0"></div>
            <div class="stat-ligne"><span class="stat-nom">Constitution</span><button type="button" class="btn-stat" onclick="changeStat('stateConstitution', -1)">−</button><span class="stat-valeur" id="stateConstitution">0</span><button type="button" class="btn-stat" onclick="changeStat('stateConstitution', 1)">+</button><input type="hidden" name="personnage[stateConstitution]" id="stateConstitution_input" value="0"></div>
            <div class="stat-ligne"><span class="stat-nom">Rapidité</span><button type="button" class="btn-stat" onclick="changeStat('stateRapidite', -1)">−</button><span class="stat-valeur" id="stateRapidite">0</span><button type="button" class="btn-stat" onclick="changeStat('stateRapidite', 1)">+</button><input type="hidden" name="personnage[stateRapidite]" id="stateRapidite_input" value="0"></div>
            <div class="stat-ligne"><span class="stat-nom">Intelligence</span><button type="button" class="btn-stat" onclick="changeStat('stateIntelligence', -1)">−</button><span class="stat-valeur" id="stateIntelligence">0</span><button type="button" class="btn-stat" onclick="changeStat('stateIntelligence', 1)">+</button><input type="hidden" name="personnage[stateIntelligence]" id="stateIntelligence_input" value="0"></div>

            <hr class="fiche-separateur-stats">

            {# Résistances #}
            <div class="stat-ligne"><span class="stat-nom">Rés. Physique</span><button type="button" class="btn-stat" onclick="changeStat('resistancePhysique', -1)">−</button><span class="stat-valeur" id="resistancePhysique">0</span><button type="button" class="btn-stat" onclick="changeStat('resistancePhysique', 1)">+</button><input type="hidden" name="personnage[resistancePhysique]" id="resistancePhysique_input" value="0"></div>
            <div class="stat-ligne"><span class="stat-nom">Rés. Magique</span><button type="button" class="btn-stat" onclick="changeStat('resistanceMagique', -1)">−</button><span class="stat-valeur" id="resistanceMagique">0</span><button type="button" class="btn-stat" onclick="changeStat('resistanceMagique', 1)">+</button><input type="hidden" name="personnage[resistanceMagique]" id="resistanceMagique_input" value="0"></div>
            <div class="stat-ligne"><span class="stat-nom">Rés. Mentale</span><button type="button" class="btn-stat" onclick="changeStat('resistanceMentale', -1)">−</button><span class="stat-valeur" id="resistanceMentale">0</span><button type="button" class="btn-stat" onclick="changeStat('resistanceMentale', 1)">+</button><input type="hidden" name="personnage[resistanceMentale]" id="resistanceMentale_input" value="0"></div>
        </div>

        {# --- COLONNE 3 : LISTE DES ATTAQUES (Séparées par type) --- #}
        <div class="fiche-col-attaques">
            <h3>Capacités</h3>
            
            <div class="cat-attaque-section">
                <h4>⚔ Physiques</h4>
                <div id="liste-physique" class="attaques-container">
                    <p class="empty-msg">Aucune attaque physique.</p>
                </div>
            </div>

            <div class="cat-attaque-section">
                <h4>✨ Magiques</h4>
                <div id="liste-magique" class="attaques-container">
                    <p class="empty-msg">Aucun sort magique.</p>
                </div>
            </div>
        </div>

        {# --- COLONNE 4 : Carnet + Histoire --- #}
        <div class="fiche-col-droite">
            <h3>Carnet de voyage</h3>
            <textarea name="personnage[carnetDeVoyage]" class="fiche-textarea"></textarea>

            <h3 style="margin-top: 15px;">Histoire</h3>
            <textarea name="personnage[histoire]" class="fiche-textarea"></textarea>
        </div>
    </div>

    {# ===== INVENTAIRE (Plein écran en bas) ===== #}
    <div class="inventaire-section">
        <h3>Inventaire</h3>
        <textarea name="personnage[inventaire]" class="fiche-textarea fiche-textarea-inventaire"></textarea>
    </div>

    {# ===== MODALE DE CRÉATION / MODIFICATION D'ATTAQUE ===== #}
    <div id="modalAttaque" class="modal-medieval" style="display:none;">
        <div class="modal-content">
            <h3 id="modalTitle">✨ Nouvelle Capacité</h3>
            <input type="hidden" id="edit_index">

            <div class="form-group">
                <label>Type d'attaque</label>
                <select id="atk_type" onchange="toggleTypeFields()">
                    <option value="physique">Physique</option>
                    <option value="magique">Magique</option>
                </select>
            </div>

            <div class="form-group">
                <label>Nom</label>
                <input type="text" id="atk_nom">
            </div>

            <div class="form-row">
                <div>
                    <label>Dégâts</label>
                    <input type="number" id="atk_degat">
                </div>
                <div id="field_contre">
                    <label>Dégât Contre</label>
                    <input type="number" id="atk_contre">
                </div>
                <div id="field_magie" style="display:none;">
                    <label>Coût (Mana/Vie)</label>
                    <input type="number" id="atk_cout">
                </div>
            </div>

            <div class="form-group">
                <label>Description / Effet</label>
                <textarea id="atk_desc"></textarea>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-medieval" onclick="sauvegarderAttaque()">Enregistrer</button>
                <button type="button" class="btn-medieval btn-quitter" onclick="closeAttaqueModal()">Annuler</button>
            </div>
        </div>
    </div>

</form>

{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/fiche-personnage.js') }}"></script>
{% endblock %}