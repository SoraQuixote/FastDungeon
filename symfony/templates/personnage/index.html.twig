{% extends 'base.html.twig' %}

{% block title %}Mes Personnages{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/personnage-index.css') }}">
{% endblock %}

{% block body %}
<div class="taverne-container">
    <div class="taverne-header">
        <h1 class="medieval-title"> Registre de mes personnages </h1>
        <a href="{{ path('app_personnage_new') }}" class="btn-medieval">Créer un Personnage</a>
    </div>

    <div class="personnages-grid">
        {% for personnage in personnages %}
            <a href="{{ path('app_personnage_edit', {'id': personnage.id}) }}" class="perso-card-link">
                <div class="perso-card">
                    <div class="perso-frame">
                        <img src="{{ personnage.portrait 
                            ? asset('uploads/portraits/' ~ personnage.portrait) 
                            : asset('images/default-avatar.png') }}" 
                            alt="Portrait" class="perso-portrait">
                    </div>
                    
                    <div class="perso-info">
                        <h2 class="perso-nom">{{ personnage.prenom }} {{ personnage.nom }}</h2>
                        <p class="perso-stats">Niveau {{ personnage.niveau|default(1) }}</p>
                    </div>
                </div>
            </a>
        {% endfor %}
    </div>
</div>
{% endblock %}