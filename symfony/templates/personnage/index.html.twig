{% extends 'base.html.twig' %}

{% block title %}Mes perssonages{% endblock %}

{% block body %}
    <h1> Mes Personnages </h1>

    <table class="table">
        <tbody>
        {% for personnage in personnages %}
            <tr>
                <td>{{ personnage.nom }}</td>
                <td>{{ personnage.prenom }}</td>
                <td>
                    <a href="{{ path('app_personnage_show', {'id': personnage.id}) }}">show</a>
                    <a href="{{ path('app_personnage_edit', {'id': personnage.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Vous n'avez aucun perssonages pour le moments</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_personnage_new') }}">Nouveau perssonage</a>
{% endblock %}
