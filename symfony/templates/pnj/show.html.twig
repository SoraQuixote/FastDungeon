{% extends 'base.html.twig' %}

{% block title %}Pnj{% endblock %}

{% block body %}
    <h1>Pnj</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ pnj.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ pnj.nom }}</td>
            </tr>
            <tr>
                <th>Prenom</th>
                <td>{{ pnj.prenom }}</td>
