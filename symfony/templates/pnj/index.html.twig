{% extends 'base.html.twig' %}

{% block title %}Pnj index{% endblock %}

{% block body %}
    <h1>Pnj index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Prenom</th>
                <th>Type</th>
                <th>Description</th>
                <th>Histoire</th>
                <th>Inventaire</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for pnj in pnjs %}
            <tr>
                <td>{{ pnj.id }}</td>
                <td>{{ pnj.nom }}</td>
                <td>{{ pnj.prenom }}</td>
                <td>{{ pnj.type }}</td>
                <td>{{ pnj.description }}</td>
                <td>{{ pnj.histoire }}</td>
                <td>{{ pnj.inventaire }}</td>
                <td>
                    <a href="{{ path('app_pnj_show', {'id': pnj.id}) }}">show</a>
                    <a href="{{ path('app_pnj_edit', {'id': pnj.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_pnj_new') }}">Create new</a>
{% endblock %}
