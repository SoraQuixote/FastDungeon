{% extends 'base.html.twig' %}

{% block title %}Mode MJ : {{ campagne.nom }}{% endblock %}

{% block body %}
    <div class="mj-dashboard-container"> {# Nouveau conteneur de centrage #}
        
        <nav class="mj-navbar">
            <div class="mj-nav-links">
                <button class="nav-item active" onclick="openTab(event, 'tab-campagne')">Campagne</button>
                <button class="nav-item" onclick="openTab(event, 'tab-pnj')">PNJ</button>
                <button class="nav-item" onclick="openTab(event, 'tab-plateau')">Plateaux</button>
            </div>
            <div class="mj-nav-actions">
                <a href="{{ path('app_campagne_index') }}" class="btn-quit-mj">Quittez campagne</a>
            </div>
        </nav>

        <main class="mj-main-content">
            {# --- ONGLET 1 : CAMPAGNE --- #}
            <div id="tab-campagne" class="tab-content active">
                <section class="parchemin-scroll">
                    <h1>Configuration de la Campagne</h1>
                    
                    {{ form_start(form) }}
                        <div class="medieval-form-grid">
                            <div class="form-group">
                                {{ form_label(form.nom) }}
                                {{ form_widget(form.nom) }}
                            </div>
                            <div class="form-group">
                                {{ form_label(form.etat) }}
                                {{ form_widget(form.etat) }}
                            </div>
                            <div class="form-group full-width">
                                {{ form_label(form.textPresentation) }}
                                {{ form_widget(form.textPresentation) }}
                            </div>
                            <div class="form-group full-width">
                                {{ form_label(form.scenario) }}
                                {{ form_widget(form.scenario) }}
                            </div>
                            <div class="form-group full-width">
                            {{ form_label(form.carteMonde, "Carte du Monde") }}
                            {# Zone de prévisualisation cliquable #}
                            <div class="portrait-zone" onclick="document.getElementById('{{ form.carteMonde.vars.id }}').click()" title="Cliquez pour changer la carte">
                                {# On n'affiche la balise IMG QUE si on a vraiment une valeur en base de données #}
                                {% if campagne.carteMonde and campagne.carteMonde != "" %}
                                    <img id="mapPreview" src="{{ asset('uploads/cartes/' ~ campagne.carteMonde) }}" alt="Carte du monde" style="max-width: 100%; display: block;" onerror="this.style.display='none'; document.getElementById('mapPlaceholder').style.display='flex';">
                                {% else %}
                                    <img id="mapPreview" src="" alt="" style="display:none; max-width: 100%;">
                                {% endif %}

                                <div id="mapPlaceholder" {% if campagne.carteMonde %}style="display:none;"{% endif %} class="placeholder-flex">
                                    <span class="portrait-icone">🗺️</span>
                                    <span class="portrait-texte">Cliquez pour ajouter une carte</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-actions-bottom">
                            <button class="btn-medieval-submit">sauvegarder</button>
                        </div>
                    {{ form_end(form) }}
                </section>
            </div>

            {# --- ONGLET 2 : PNJs --- #}
            <div id="tab-pnj" class="tab-content">
                <section class="parchemin-scroll">
                    <div class="header-with-btn">
                        <h1>Les Figurants de l'Histoire</h1>
                        <a href="{{ path('app_pnj_new', {'campagne': campagne.id}) }}" class="btn-medieval">Recruter un PNJ</a>
                    </div>
                    <div class="pnj-grid">
                        {% for pnj in campagne.pnjs %}
                            <div class="campagne-card">
                                <h3>{{ pnj.nom }}</h3>
                                <a href="{{ path('app_pnj_edit', {'id': pnj.id}) }}" class="btn-link">Modifier</a>
                            </div>
                        {% else %}
                            <p class="empty-msg">Aucun PNJ n'a été créé.</p>
                        {% endfor %}
                    </div>
                </section>
            </div>

            {# --- ONGLET 3 : PLATEAUX --- #}
            <div id="tab-plateau" class="tab-content">
                <section class="parchemin-scroll">
                    <h1>Plateaux de jeu</h1>
                
                </section>
            </div>
        </main>
    </div>
    {% block javascripts %}
        {# On importe le fichier JS externe #}
        <script src="{{ asset('js/campagne.js') }}"></script>
        
        {# On initialise la fonction avec l'ID Twig #}
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                initMapPreview('{{ form.carteMonde.vars.id }}');
            });
        </script>

        <script>
        function openTab(evt, tabName) {
            var i, tabcontent, tablinks;
            tabcontent = document.getElementsByClassName("tab-content");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
                tabcontent[i].classList.remove("active");
            }
            tablinks = document.getElementsByClassName("nav-item");
            for (i = 0; i < tablinks.length; i++) {
                tablinks[i].classList.remove("active");
            }
            document.getElementById(tabName).style.display = "block";
            document.getElementById(tabName).classList.add("active");
            evt.currentTarget.classList.add("active");
        }
        </script>
    {% endblock %}
{% endblock %}