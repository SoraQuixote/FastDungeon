{% extends 'base.html.twig' %}

{% block title %}Campagne{% endblock %}

{% block body %}
    <h1>Campagne</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ campagne.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ campagne.nom }}</td>
            </tr>
            <tr>
                <th>Scenario</th>
                <td>{{ campagne.scenario }}</td>
            </tr>
            <tr>
                <th>CarteMonde</th>
                <td>{{ campagne.carteMonde }}</td>
            </tr>
            <tr>
                <th>TextPresentation</th>
                <td>{{ campagne.textPresentation }}</td>
            </tr>
            <tr>
                <th>Etat</th>
                <td>{{ campagne.etat }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_campagne_index') }}">back to list</a>

    <a href="{{ path('app_campagne_edit', {'id': campagne.id}) }}">edit</a>

    {{ include('campagne/_delete_form.html.twig') }}
{% endblock %}
