<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}FastDungeon{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2290%22>⚔️</text></svg>">
        <link rel="stylesheet" href="{{ asset('css/style.css') }}">
        {% block stylesheets %}{% endblock %}
    </head>
    <svg style="position: absolute; width: 0; height: 0;" xmlns="http://www.w3.org/2000/svg" version="1.1">
        <defs>
            <filter id="rough-edges">
                <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="3" result="noise" />
                <feDisplacementMap in="SourceGraphic" in2="noise" scale="7" />
            </filter>
        </defs>
    </svg>
    <body>

        <nav class="navbar-medieval">
            <div class="nav-container">
                <h1 class="logo"> Fast Dungeon</h1>
                
                <div class="nav-links">
                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a href="{{ path('app_campagne_index') }}" class="link-medieval">Les Campagnes</a>
                            <a href="{{ path('app_personnage_index') }}" class="link-medieval">Les Personnages</a>
                            <a class="link-medieval" href="{{ path('app_admin_users') }}">Gérer Utilisateurs</a>
                            <span class="aventurier-name">Aventurier : <strong>{{ app.user.pseudo }}</strong></span>
                            <a href="{{ path('app_logout') }}" class="btn-quitter">Quitter la taverne</a>
                        </li>
                    {% elseif app.user %}
                        <a href="{{ path('app_campagne_index') }}" class="link-medieval">Campagnes</a>
                        <a href="{{ path('app_personnage_index') }}" class="link-medieval">Mes Personnages</a>
                        <span class="aventurier-name">Aventurier : <strong>{{ app.user.pseudo }}</strong></span>
                        <a href="{{ path('app_logout') }}" class="btn-quitter">Quitter la taverne</a>
                    {% endif %}
                </div>
            </div>
        </nav>

        {% if app.request.attributes.get('_route') != 'app_campagne_edit' %}
            <nav class="main-site-nav">
                {# Ton menu habituel avec Accueil, Personnages, etc. #}
            </nav>
        {% endif %}

        <main class="page-parchemin">
            {% block body %}{% endblock %}
        </main>

        {% block javascripts %}{% endblock %}
    </body>
</html>